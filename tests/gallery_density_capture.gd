extends "res://tests/artifact_gallery_probe.gd"
func _ready()->void:
	get_window().size=Vector2i(1600,900);get_window().content_scale_size=Vector2i(1600,900)
	await super._ready()
func _check_gallery()->void:
	await super._check_gallery()
	get_window().size=Vector2i(1024,720);get_window().content_scale_size=Vector2i(1024,720)
	await _frames(5)
	var gallery:=await _gallery_open()
	check(_cards(gallery).back().get_global_rect().end.y<=gallery.browse_scroll.get_global_rect().end.y+1,"Both inventory rows fit above the pager at720px")
	await _shot("gallery-narrow-grid")
	gallery.select("c03");await _frames(4)
	await _shot("gallery-narrow-detail")
	gallery.detail_scroll.scroll_vertical=100000;await _frames(3)
	check(gallery.find_child("ExchangeButton",true,false)!=null,"Exchange action retained in narrow detail")
	await _shot("gallery-narrow-actions")
	gallery.set_view("rumors");await _frames(4)
	check(not gallery.detail_column.visible,"Narrow rumors hide unrelated detail")
	await _shot("gallery-narrow-rumors")
	gallery.close();await _frames(3)
	get_window().size=Vector2i(420,900);get_window().content_scale_size=Vector2i(420,900);await _frames(5)
	gallery=await _gallery_open()
	check(Rect2(Vector2.ZERO,gallery.get_viewport_rect().size).encloses(gallery.panel.get_global_rect()),"420px gallery fits")
	await _shot("gallery-component420")
	gallery.select("c03");await _frames(5)
	check(Rect2(Vector2.ZERO,gallery.get_viewport_rect().size).encloses(gallery.panel.get_global_rect()),"420px selected object fits")
	await _shot("gallery-component420-detail")
	gallery.close();await _frames(3)
	get_window().size=Vector2i(1600,900);get_window().content_scale_size=Vector2i(1600,900)
	await _frames(4)
func _shot(label:String)->void:
	await super._shot(label)
	if label=="gallery-grid":
		var canvas:CanvasLayer=get_meta("artifact_gallery")
		var gallery:Control=canvas.get_child(0)
		gallery.effects_toggle.pressed.emit();await _frames(4)
		await super._shot("gallery-allure-expanded")
		gallery.effects_toggle.pressed.emit();await _frames(3)

