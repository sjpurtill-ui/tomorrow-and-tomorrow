   },
   "observation": "Feast days are fixed to the months of the god's calendar, and work stops for them across the land.",
   "art": "res://assets/ui/research/culture-v1.png"
  },
  "royal_mourning": {
   "effects": {
    "cohesion": 0.0007,
    "labor_efficiency": -0.005,
