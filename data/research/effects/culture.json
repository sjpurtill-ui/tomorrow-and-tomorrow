   },
   "observation": "Poems set two rivals arguing in verse, the hoe against the plow, summer against winter, and the audience judges.",
   "art": "res://assets/ui/research/culture-v1.png"
  },
  "heroic_song_cycle": {
   "effects": {
    "cohesion": 0.0038,
    "knowledge_preservation": 0.0023,
    "legitimacy": 0.0026,
    "warfare_readiness": 0.0033
   },
   "observation": "Songs of a great ruler's deeds are sung and written down as a cycle every child and soldier knows.",
