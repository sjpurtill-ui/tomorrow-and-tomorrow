## Game-year equivalent of a historical calendar year on the pacing curve.
static func game_year_for(historical_year:float)->float:
	if historical_year<=float(CURVE[0][1]): return float(CURVE[0][0])
	for index in range(1,CURVE.size()):
		var high:Array=CURVE[index]
		if historical_year<=float(high[1]):
			var low:Array=CURVE[index-1]
			return lerpf(float(low[0]),float(high[0]),(historical_year-float(low[1]))/(float(high[1])-float(low[1])))
	return float(CURVE[CURVE.size()-1][0])

## Cost multiplier for inquiry at `era` (game-year equivalent) when the society's
## scholarship stands at `level`.
static func cost_multiplier(era:float,level:float)->float:
	return pow(2.0,minf(30.0,maxf(0.0,era-level-WINDOW)/DOUBLING))
