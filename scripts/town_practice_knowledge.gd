		_e("battlefield_arms_gathered","Arms Gathered from the Field After a Battle","security","Military readiness",195275,0.0077,["common_armory", "bronze_weaponry"],["defense", "warfare"],"After a fight the spears, shields and arrows left on the field are collected, counted and sent to the armory, and broken ones go to the smiths.",{"warfare_readiness": 0.002, "metal_yield": 0.001}),
		_e("kin_ransom_customs","Captured Kin Ransomed by the Family or the Temple","security","Crisis resilience",200750,0.0076,["temple_common_storehouse", "spoils_shared_assembly"],["defense", "warfare"],"A man taken in war is bought back by his family, or by the temple if his family cannot pay, so fighters know they will not be abandoned.",{"cohesion": 0.002, "warfare_readiness": 0.001, "legitimacy": 0.001}),
		_e("garrison_relief_turns","Border Forts Relieved by Fresh Men in Turn","security","Military readiness",212795,0.0075,["border_fortress_chains", "rotating_watch_captaincy"],["defense", "warfare"],"Soldiers in the border forts are replaced by fresh men after a set term, so the forts stay manned without wearing out a single company.",{"security_efficiency": 0.002, "fatigue": -0.001, "warfare_readiness": 0.001}),
