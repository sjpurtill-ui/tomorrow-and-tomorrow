		_e("oiled_labour_massage","Oiled Massage to Ease a Slow Labour","demography","Maternal safety",101105,0.0151,["obstructed_labor_recognition", "seed_oil_pressing"],["population", "society"],"Midwives rub the mother's belly and back with warm oil and help her change position when a labour is slow.",{"maternal_safety": 0.002}),
		_e("late_pregnancy_light_work","Women Near Their Time Spared Heavy Loads","demography","Maternal safety",108405,0.0119,["obstructed_labor_recognition", "household_task_division"],["population", "society"],"In the last months before a birth a woman stops carrying water and grinding grain, and her kinswomen take over those tasks.",{"maternal_safety": 0.002, "labor_demand": 0.0005}),
		_e("back_to_back_house_lanes","Lanes of Houses Built Back to Back","demography","Shelter capacity",118625,0.0108,["rooms_added_as_family_grows", "public_space_allocation"],["population", "society"],"Houses are built in rows sharing their back walls, each opening onto a narrow lane, so a town holds many households on little ground.",{"housing_output": 0.003, "cohesion": 0.0005}),
		_e("children_kept_from_water","Small Children Kept from Canals and Wells","demography","Child survival",122275,0.0106,["hearth_hazard_proofing", "irrigation_schedules"],["population", "society"],"Small children are forbidden the canal banks and well mouths, and their older brothers and sisters are set to keep them away from deep water.",{"neonatal_survival": 0.0015, "injury_risk": -0.001}),
		_e("prepared_birth_room","A Warm, Clean Room Readied for the Birth","demography","Maternal safety",122275,0.0106,["late_pregnancy_light_work", "seasonal_sleeping_arrangements"],["population", "society"],"Before a birth is due, a room is swept, warmed and hung with clean cloths, and the mother and child stay there in the first days.",{"maternal_safety": 0.002, "neonatal_survival": 0.001}),
		_e("houses_on_town_wall","Houses Built Against the Inside of the Town Wall","demography","Shelter capacity",144175,0.0092,["town_enclosure_walls", "back_to_back_house_lanes"],["population", "society"],"New houses are set against the inner face of the town wall and use it as their back wall, so more families fit inside the town.",{"housing_output": 0.0025, "construction_rate": 0.001}),
		_e("temple_orphan_care","Orphans Taken into the God's Household","demography","Child survival",159140,0.0055,["kinswoman_wet_nurse", "temple_high_steward"],["population", "society"],"Children with no kin to raise them are given to the temple, which feeds them among its workers and teaches them a task.",{"neonatal_survival": 0.002, "cohesion": 0.001, "labor_demand": 0.0005}),
