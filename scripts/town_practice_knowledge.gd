		_e("river_boat_letters","Letters Sent by Fast Boat Along the River","knowledge","Communication",184325,0.0078,["letter_greeting_formula", "hide_covered_boats"],["information", "research"],"Urgent letters go down the river on light boats rowed in relays, reaching the next town far sooner than a runner on foot.",{"travel_speed": 0.002, "state_capacity": 0.001}),
		_e("enveloped_letters","Letters Sealed Inside Clay Envelopes","knowledge","Communication",195275,0.0077,["letter_greeting_formula", "cylinder_seals"],["information", "research"],"A letter is wrapped in a thin clay envelope rolled with the sender's seal, which must be broken to read it, so no one on the road can alter it.",{"security_efficiency": 0.001, "trade_capacity": 0.002, "state_capacity": 0.001}),
		_e("merchant_partner_letters","Merchants' Letters Between Home and Partners Abroad","knowledge","Communication",204035,0.0076,["enveloped_letters", "funded_trade_journeys"],["information", "research"],"Traders write home from abroad about prices, debts and caravans, and partners at home send back orders and news by the next train.",{"trade_capacity": 0.003, "knowledge_preservation": 0.001}),
		_e("scribe_final_examination","Pupils Questioned in a Final Examination","knowledge","Directed attention",206225,0.0076,["model_contract_lessons", "scribal_copying_tests"],["information", "research"],"Before a pupil leaves the tablet-house, a master questions him on signs, sums, measures and the wording of contracts.",{"knowledge_preservation": 0.002, "state_capacity": 0.001}),
		_e("evening_star_records","Risings of the Evening Star Recorded Year by Year","knowledge","Observers",209875,0.0038,["crescent_month_count", "star_hour_tables"],["information", "research"],"Sky watchers write down the night the bright evening and morning star first and last appears each year, building a record that runs for decades.",{"knowledge_preservation": 0.002, "legitimacy": 0.001}),
		_e("first_line_catalogues","Lists of Works by Their First Lines","knowledge","Preserved knowledge",209875,0.0075,["duplicate_contract_copies", "formal_archives", "written_lore_tablets"],["information", "research"],"Archivists list the songs and stories held in a collection by their opening words, so a missing tablet can be noticed and found.",{"knowledge_preservation": 0.003}),
		_e("raised_grinding_querns","Querns Set on Raised Benches for Grinding","labor","Work efficiency",106945,0.0125,["flour_sifting"],["administration", "training"],"Grinding stones are set into a waist-high bench of clay, so women grind kneeling or standing instead of bent over a stone on the floor.",{"labor_efficiency": 0.0015, "fatigue": -0.001}),
		_e("fieldworker_water_carriers","Water Carried to Workers in the Fields","labor","Workload balance",108405,0.0119,["seasonal_labor_pooling"],["administration", "training"],"Boys and old men carry water skins along the rows at harvest, so reapers need not walk back to the well.",{"fatigue": -0.001, "labor_efficiency": 0.001}),
		_e("great_work_completion_feasts","Workers Feasted When a Great Work Is Finished","labor","Able workforce",122275,0.0106,["great_work_parties", "temple_festival_meals"],["administration", "training"],"When a dyke or shrine is finished, the crews who built it are given a feast of meat and beer before they go home.",{"cohesion": 0.0015, "fatigue": -0.001, "labor_efficiency": 0.001}),
		_e("new_moon_rest_day","Rest on the Day of the New Moon","labor","Workload balance",122275,0.0106,["crescent_month_count"],["administration", "training"],"No field or workshop labour is asked on the day the new moon is first seen, and households keep it with a meal.",{"fatigue": -0.0015, "cohesion": 0.001}),
		_e("tool_issue_tallies","Tools Issued and Returned Against a Tally","labor","Coordination",122275,0.0106,["load_tallies"],["administration", "training"],"Copper tools are handed out to crews in the morning against a tally and counted back at night, so none goes missing.",{"task_coordination": 0.002, "repair_capacity": 0.001, "storage_loss": -0.001}),
		_e("captive_field_labour","War Captives Set to Grinding and Weaving","labor","Able workforce",133225,0.0099,["captive_adoption"],["administration", "training"],"Men and women taken in raids are put to work at the querns, looms and fields of the temple or chief, adding hands without new births.",{"labor_efficiency": 0.001, "cohesion": -0.002}),
		_e("shoulder_pole_loads","Loads Carried on a Shoulder Pole","labor","Work efficiency",133225,0.0099,["load_bundling_by_weight"],["administration", "training"],"Water jars and baskets are hung from both ends of a pole across the shoulders, so one carrier moves a balanced double load.",{"labor_efficiency": 0.001, "haul_capacity": 0.002, "fatigue": -0.001}),
		_e("levy_service_turns","Levy Duty Taken in Turns So No Household Serves Twice","labor","Workload balance",136875,0.0097,["shared_labor_registers", "grain_levy_accounting"],["administration", "training"],"The register shows who served last, and the levy is called from households that have not yet served, so the burden is spread.",{"fatigue": -0.001, "cohesion": 0.001, "legitimacy": 0.001}),
		_e("year_round_skilled_core","A Core of Year-Round Skilled Workers at the Great Works","labor","Able workforce",142715,0.0062,["gangs_of_ten", "great_work_completion_feasts"],["administration", "training"],"Masons, surveyors and toolmakers stay at a great work all year, while farmers come only for their season of levy duty.",{"labor_efficiency": 0.0015, "construction_rate": 0.001}),
		_e("gang_marks_on_blocks","Each Gang's Mark Painted on Its Blocks","labor","Coordination",144905,0.0092,["gangs_of_ten", "tool_issue_tallies"],["administration", "training"],"Every gang paints its name on the stones it quarries and sets, so the overseer can count each gang's work and find who set a bad block.",{"task_coordination": 0.002, "construction_rate": 0.002}),
		_e("one_step_workers","Each Worker in the Workshop Keeps to One Step","labor","Work efficiency",151475,0.0088,["temple_workshops", "tool_reach_zoning"],["administration", "training"],"In the large workshops one worker only spins, another only weaves and another only finishes, each growing quick at a single task.",{"labor_efficiency": 0.0015, "craft_output": 0.002}),
		_e("extra_day_rations","Extra Rations for Extra Days Worked","labor","Workload balance",169725,0.0079,["worker_ration_lists", "new_moon_rest_day"],["administration", "training"],"A worker who serves beyond his owed days is given extra bread and beer for each extra day, written on the ration list.",{"labor_efficiency": 0.001, "fatigue": -0.001, "food_storage": -0.001}),
		_e("hauling_rhythm_clapper","A Clapper Sets the Pull for Hauling Teams","labor","Coordination",171915,0.0079,["ox_drawn_sledges", "year_round_skilled_core"],["administration", "training"],"When a great stone is dragged, one man stands on it and claps the rhythm, so every rope pulls at the same moment.",{"task_coordination": 0.003, "haul_capacity": 0.002}),
		_e("trodden_brick_clay","Brick Clay Trodden by Teams Before Moulding","labor","Work efficiency",175565,0.0079,["brick_quotas"],["administration", "training"],"Teams tread the wet clay and straw together in pits until it is even, so the moulders can keep up their daily count.",{"labor_efficiency": 0.001, "construction_rate": 0.002}),
		_e("sick_workers_marked","Sick Workers Marked Off the Day's Count","labor","Able workforce",188705,0.0077,["man_day_accounts", "crew_count_scribes"],["administration", "training"],"The foreman's list marks who was sick or absent each day, so a sick worker is not charged for labour he could not do.",{"fatigue": -0.001, "health_protection": 0.001, "labor_efficiency": 0.001}),
		_e("measured_canal_stretches","Canal Clearing Shared by Measured Stretches","labor","Coordination",200750,0.0076,["gang_marks_on_blocks", "daily_task_norms"],["administration", "training"],"Each village is given a measured length of the canal to clear, so the work is fair and a skipped stretch is easy to find.",{"task_coordination": 0.003, "cultivation_yield": 0.001}),
		_e("mill_house_grinding","Grain Ground in Mill-Houses by Many Hands","labor","Work efficiency",201115,0.0076,["raised_grinding_querns", "work_gang_bakeries"],["administration", "training"],"The great households grind grain for their workers in mill-houses where rows of women work querns side by side under one overseer.",{"labor_efficiency": 0.0015, "food_output": 0.001}),
		_e("debt_service_limit","Debt Service Limited to a Set Term","labor","Workload balance",201845,0.0076,["levy_service_turns", "fixed_interest_loans"],["administration", "training"],"A debtor's wife, son or servant who works off a debt in the lender's house must be set free after a few years, whatever is still owed.",{"cohesion": 0.0015, "fatigue": -0.001, "legitimacy": 0.001}),
		_e("reed_mat_weaving","Reed Mats Woven in Bulk for Roofs and Floors","production","Craft capacity",102565,0.0145,["reed_bundle_houses", "basketry"],["crafting", "materials"],"Split reeds are plaited into large mats by the hundred, to be laid over roof beams under the mud and spread on floors.",{"craft_output": 0.002, "construction_rate": 0.002}),
		_e("graded_wool_weighing","Wool Weighed Out by Grade for Spinning","production","Standardization",114975,0.0111,["wool_spinning", "balance_beam_weights"],["crafting", "materials"],"Fleece is sorted into fine, middling and coarse and weighed out to the spinners, who must return the same weight as yarn.",{"standardization": 0.003, "craft_output": 0.001}),
		_e("whetstone_sharpening","Copper Blades Kept Sharp on Whetstones","production","Tool quality",118625,0.0108,["copper_casting"],["crafting", "materials"],"Every worker with a copper blade carries a small fine stone and hones the edge after use instead of returning it to the smith.",{"tool_quality": 0.003, "repair_capacity": 0.002}),
		_e("scrap_copper_remelting","Broken Copper Tools Melted Down Again","production","Material supply",122275,0.0106,["copper_casting", "reduction_firing"],["crafting", "materials"],"Worn and broken copper tools are collected and melted again for casting, so no metal is thrown away.",{"metal_yield": 0.003, "ecological_pressure": -0.001}),
		_e("bow_drill_boring","Bow Drills Bore Holes for Joints and Pegs","production","Tool quality",133225,0.0099,["copper_carpentry_tools"],["crafting", "materials"],"A cord wrapped round the drill shaft is worked back and forth with a bow, boring clean holes for pegs much faster than twisting by hand.",{"tool_quality": 0.003, "craft_output": 0.001}),
		_e("jars_of_set_capacity","Storage Jars Made to a Set Capacity","production","Standardization",133955,0.0099,["mould_made_bowls", "standard_unit_naming"],["crafting", "materials"],"Potters make store jars that each hold a known measure, so a room of jars can be counted as so many measures of grain or oil.",{"standardization": 0.004, "container_capacity": 0.002}),
		_e("mortise_joined_furniture","Beds and Stools Joined with Mortise and Tenon","production","Craft capacity",135415,0.0098,["timber_post_beam_connections", "copper_carpentry_tools"],["crafting", "materials"],"Carpenters fit legs and rails into cut sockets and peg them, making beds and stools that stand firm for years.",{"craft_output": 0.003, "housing_output": 0.001}),
		_e("copper_standard_rod","A Copper Rod Kept as the Standard Length","production","Standardization",151475,0.0088,["standard_unit_naming", "standard_weight_sets"],["crafting", "materials"],"A cast copper rod marked with the cubit and its parts is kept at the temple, and builders' cords are checked against it.",{"standardization": 0.004, "construction_rate": 0.001}),
		_e("hard_stone_bead_batches","Hard Stone Beads Bored in Workshop Batches","production","Craft capacity",158775,0.0056,["bow_drill_boring", "relay_trade_gemstones", "visiting_master_craftsmen"],["crafting", "materials"],"Bead makers saw, grind and bore hard red stone in batches, passing each bead through the same steps, for trade far beyond the town.",{"craft_output": 0.003, "trade_capacity": 0.001}),
		_e("stamped_bricks","Bricks Stamped with the Ruler's Name","production","Standardization",177025,0.0079,["standard_brick_proportions", "first_basket_founding"],["crafting", "materials"],"Moulders stamp the bricks for a ruler's buildings with his name, so they are counted and cannot be carried off to private houses.",{"standardization": 0.002, "legitimacy": 0.001}),
		_e("pleated_linen","Linen Pleated on Grooved Boards","production","Craft capacity",182865,0.0078,["palace_weaving_houses", "one_step_workers"],["crafting", "materials"],"Fine linen is pressed damp into grooved boards so it dries in narrow pleats, a mark of good cloth worn by people of rank.",{"craft_output": 0.002, "trade_capacity": 0.001}),
		_e("scented_oils","Scented Oils Made by Steeping Plants in Oil","production","Craft capacity",184325,0.0052,["seed_oil_pressing", "beam_olive_press"],["crafting", "materials"],"Flowers, resins and herbs are steeped in warm oil for days and strained, giving scented oils for anointing and trade.",{"craft_output": 0.002, "trade_capacity": 0.002}),
		_e("standard_cloth_lengths","Cloth Woven to Standard Lengths for Trade","production","Standardization",184325,0.0078,["copper_standard_rod", "graded_wool_weighing", "palace_weaving_houses"],["crafting", "materials"],"Weavers make lengths of cloth of one size and weight, so traders can buy and sell them by the piece.",{"standardization": 0.003, "trade_capacity": 0.002}),
		_e("bronze_sickles","Bronze Sickles Replace Flint-Toothed Ones","production","Tool quality",195275,0.0077,["bronze_alloying", "whetstone_sharpening"],["crafting", "materials"],"Harvesters cut grain with cast bronze sickles that hold an edge and can be reground, instead of wooden ones set with flint teeth.",{"tool_quality": 0.003, "cultivation_yield": 0.001, "labor_efficiency": 0.001}),
		_e("checked_measuring_vessels","Measuring Vessels Checked and Marked by Officials","production","Standardization",197100,0.0076,["jars_of_set_capacity", "proclaimed_standard_weights"],["crafting", "materials"],"Officials fill each trader's measuring vessel against the standard and mark it as true, and a false measure is broken and fined.",{"standardization": 0.003, "trade_capacity": 0.001, "legitimacy": 0.001}),
		_e("edge_and_body_bronze","Hard Bronze for Edges, Soft Bronze for Vessels","production","Tool quality",211700,0.0050,["weighed_alloy_recipes", "bronze_work_hardening"],["crafting", "materials"],"Smiths cast blades and chisels from bronze rich in tin and keep the softer metal for bowls and sheet that must be beaten into shape.",{"tool_quality": 0.003, "metal_yield": 0.001}),
		_e("chewed_twig_toothcare","Chewed Twigs and Ash Powder for Cleaning Teeth","health","General health",104025,0.0138,["herbal_classification"],["health", "illness"],"People clean their teeth with the frayed end of a chewed twig and rub them with ash or powdered stone.",{"health_protection": 0.001}),
		_e("dislocation_reduction","Dislocated Joints Pulled Back into Place","health","Injury safety",104755,0.0135,["traction_fracture_setting"],["health", "illness"],"Healers pull and turn a dislocated shoulder or jaw back into its socket and bind it, so the limb works again.",{"injury_risk": -0.0015, "labor_efficiency": 0.001}),
		_e("boiled_herb_decoctions","Remedies Boiled into Decoctions","health","Disease control",114975,0.0111,["herbal_classification", "clay_dome_ovens"],["health", "illness"],"Roots and leaves are boiled down in water or beer to a strong brew that the sick drink in set amounts.",{"health_protection": 0.001, "disease_exposure": -0.001}),
		_e("hand_washing_ewer","Hands Washed from Ewer and Basin Before Meals","health","Water & sanitation",133225,0.0099,["water_container_cleaning_customs", "sheet_copper_riveting"],["health", "illness"],"Before eating, water is poured over the hands from a spouted ewer into a basin, and the dirty water is carried away.",{"disease_exposure": -0.0015, "sanitation": 0.001}),
		_e("sick_animal_separation","Diseased Animals Separated from the Flock","health","Disease control",133225,0.0099,["sickbed_distance_norms", "scrap_fed_pigs"],["health", "illness"],"A sheep, pig or ox with scab or a wasting sickness is penned apart and watched, so the rest of the herd does not catch it.",{"disease_exposure": -0.001, "food_output": 0.001}),
		_e("embedded_point_removal","Embedded Points and Splinters Cut Out of Wounds","health","Injury safety",140525,0.0095,["wound_suturing"],["health", "illness"],"A healer opens the flesh with a fine blade to draw out a broken arrow point or splinter, then washes and packs the wound.",{"injury_risk": -0.0015, "health_protection": 0.001}),
		_e("house_bathing_floors","House Bathing Floors Drained to the Street","health","Water & sanitation",151475,0.0088,["hand_washing_ewer", "stone_lined_drains"],["health", "illness"],"Houses set aside a small room with a sloping brick floor for washing, which drains through the wall into the lane drain.",{"sanitation": 0.002, "disease_exposure": -0.001}),
		_e("bite_and_sting_healers","Scorpion Stings and Snakebites Treated by Specialists","health","Injury safety",158775,0.0083,["healer_specialization_customs"],["health", "illness"],"Certain healers know the snakes and scorpions of the district and are called at once to cut, bind and treat a bite.",{"injury_risk": -0.001, "health_protection": 0.001}),
		_e("scaffold_lashing","Scaffolds Lashed for Work on High Walls","health","Injury safety",164615,0.0080,["rope_laying", "course_leveling_practice"],["health", "illness"],"Builders lash poles into scaffolds and ramps along a rising wall, so no one has to work from a ladder or the top of the wall.",{"injury_risk": -0.0015, "construction_rate": 0.001}),
		_e("purification_washing","The Sick Washed with Water and Herbs in Purification Rites","health","Disease control",169725,0.0079,["sickroom_fumigation", "river_bathing"],["health", "illness"],"The healer-priest washes the sick person with water steeped in tamarisk and other plants, and the water is poured out far from the house.",{"disease_exposure": -0.001, "cohesion": 0.0005}),
		_e("latrine_seats_over_drains","Brick Latrine Seats over Drains","health","Water & sanitation",173375,0.0079,["house_bathing_floors", "latrine_siting"],["health", "illness"],"Houses with a drain build a brick seat over it in a small room, so waste goes into the drain instead of the yard.",{"sanitation": 0.002, "disease_exposure": -0.001}),
		_e("head_wound_grading","Head Wounds Judged as Treatable or Not","health","Injury safety",177755,0.0079,["dislocation_reduction", "embedded_point_removal"],["health", "illness"],"Healers feel a head wound for cracks and watch for fever and a stiff neck, and decide from these signs whether to treat it or only ease the pain.",{"injury_risk": -0.001, "knowledge_preservation": 0.001}),
		_e("measured_remedy_doses","Remedy Doses Measured in Set Parts","health","Disease control",187975,0.0077,["boiled_herb_decoctions", "remedy_vehicles", "standard_unit_naming"],["health", "illness"],"A remedy is made from measured parts of each ingredient, so the healer can give the same dose again and judge whether it worked.",{"health_protection": 0.001, "disease_exposure": -0.001}),
		_e("well_cistern_replastering","Wells and Cisterns Cleaned and Replastered","health","Water & sanitation",195275,0.0077,["protected_wellheads", "lime_mortar"],["health", "illness"],"In the dry months each well and cistern is emptied, scraped of mud and freshly plastered, so the stored water stays clean.",{"water_safety": 0.002}),
		_e("lice_combs","Fine-Toothed Combs Against Lice","health","General health",202575,0.0076,["chewed_twig_toothcare", "head_shaving_lice"],["health", "illness"],"People comb their hair and beards daily with fine-toothed combs of bone, wood or ivory that pull out lice and their eggs.",{"health_protection": 0.001, "disease_exposure": -0.001}),
		_e("sick_cup_separation","Cups and Beds of the Sick Kept Apart","health","Disease control",202575,0.0076,["sick_animal_separation", "isolation_practice"],["health", "illness"],"No one may drink from a sick person's cup, sit on his seat or lie in his bed, so the sickness does not pass to the household.",{"disease_exposure": -0.002}),
		_e("shrine_entry_washing","Hands and Feet Washed Before Entering the Shrine","health","Water & sanitation",211700,0.0075,["hand_washing_ewer", "first_shrine_house"],["health", "illness"],"Basins of water stand at the shrine gate, and no one enters the god's court without washing hands and feet, priests most of all.",{"sanitation": 0.0015, "disease_exposure": -0.001}),
		_e("seasonal_wall_replastering","Mud Plaster Renewed on Walls After the Rains","infrastructure","Construction",79205,0.0247,["adobe_wall_construction"],["construction", "materials"],"Each year after the rains, households smear fresh mud plaster over their walls and roofs, closing cracks before they let in water.",{"repair_capacity": 0.003, "disaster_resilience": 0.002}),
		_e("raised_wet_causeways","Raised Earth Causeways Across Wet Ground","infrastructure","Public works",82855,0.0231,["flood_levees", "plank_trackways"],["construction", "materials"],"Villages build up banks of earth across marsh and flood land, so people and herds can cross dry-shod in the wet season.",{"route_speed": 0.003, "disaster_resilience": 0.002}),
		_e("stone_pivot_doors","Doors Hung on Stone Pivot Sockets","infrastructure","Housing",104025,0.0138,["timber_post_beam_connections"],["construction", "materials"],"A door's post turns in a hollow cut into a stone set in the floor, so heavy wooden doors swing easily and shut tight.",{"housing_output": 0.002, "security_efficiency": 0.001}),
		_e("flat_reed_mat_roofs","Flat Roofs Laid with Beams, Reed Mats and Clay","infrastructure","Construction",122275,0.0106,["timber_post_beam_connections", "reed_mat_weaving"],["construction", "materials"],"Roof beams are covered with reed mats and a thick layer of clay rolled smooth, giving a flat roof that sheds rain and serves as a summer workplace.",{"construction_rate": 0.003, "housing_output": 0.001}),
		_e("gravelled_main_streets","Main Streets Surfaced with Gravel and Broken Pottery","infrastructure","Public works",122275,0.0106,["public_space_allocation", "stone_lined_drains"],["construction", "materials"],"The main streets are spread with gravel and potsherds that drain quickly, so carts and porters are not stopped by mud after rain.",{"route_speed": 0.002, "sanitation": 0.001}),
		_e("brick_platform_raising","Houses Raised on Brick Platforms Above Floods","infrastructure","Resilience",128845,0.0068,["shrine_terraces", "flood_levees"],["construction", "materials"],"Whole quarters are built on platforms of packed brick and earth high enough to stay dry when the river floods.",{"disaster_resilience": 0.005, "labor_demand": 0.001}),
		_e("street_corner_wells","Public Wells at Street Crossings","infrastructure","Public works",140525,0.0095,["protected_wellheads"],["construction", "materials"],"Wells lined with brick are dug where streets meet, so every household has water within a short walk.",{"water_access": 0.002, "water_safety": 0.001}),
		_e("flood_height_records","Flood Heights Read and Recorded Each Year","infrastructure","Resilience",162425,0.0054,["disaster_memory_markers", "brick_platform_raising", "clay_record_tablets"],["construction", "materials"],"The height the river reaches each flood is read on marked steps and written down, so officials can judge the coming harvest and the danger.",{"disaster_resilience": 0.004, "cultivation_yield": 0.001}),
		_e("cut_town_reservoirs","Town Reservoirs Cut and Lined to Store Rainwater","infrastructure","Public works",173375,0.0053,["street_corner_wells", "diversion_dams"],["construction", "materials"],"Large tanks are cut into rock or lined with stone inside the town walls to catch the runoff of the rains for the dry months.",{"water_access": 0.002, "disaster_resilience": 0.002}),
		_e("spare_rebuilding_timber","Spare Timber Stored for Rebuilding After Fire","infrastructure","Resilience",173375,0.0079,["distant_timber_reserves", "flat_reed_mat_roofs"],["construction", "materials"],"The stores keep seasoned beams and reed bundles in reserve, so roofs lost to fire or storm can be replaced at once.",{"disaster_resilience": 0.003, "construction_rate": 0.001}),
		_e("building_plan_tablets","Builders Work from a Plan Drawn on a Tablet","infrastructure","Construction",175200,0.0079,["geometric_survey", "corner_squaring_method"],["construction", "materials"],"The plan of a building is drawn to scale on a tablet with its walls and doors, and the builders lay out their cords from it.",{"construction_rate": 0.002, "task_coordination": 0.001}),
		_e("dyke_high_water_watch","Dyke Watch Kept Day and Night at High Water","infrastructure","Resilience",190895,0.0077,["flood_height_records", "flood_levees"],["construction", "materials"],"When the river nears the top of its banks, men watch the dykes in shifts through the night and turn out at once to close a breach.",{"disaster_resilience": 0.004, "labor_demand": 0.001}),
		_e("dyke_stretch_duty","Field Owners Keep Their Stretch of the Dyke","infrastructure","Public works",195275,0.0077,["raised_wet_causeways", "village_track_upkeep"],["construction", "materials"],"Each landholder must keep the dyke along his field sound, and one whose neglect lets the water through repays his neighbours' lost crops.",{"disaster_resilience": 0.003, "legitimacy": 0.0005, "labor_demand": 0.0005}),
		_e("brick_count_reckoning","Bricks for a Wall Reckoned in Advance","infrastructure","Construction",202575,0.0076,["building_plan_tablets", "trodden_brick_clay"],["construction", "materials"],"Scribes work out from a wall's length, height and thickness how many bricks it needs, so moulders and carriers are set to work in the right numbers.",{"construction_rate": 0.003, "task_coordination": 0.001}),
		_e("fallen_brick_reuse","Bricks from Fallen Walls Cleaned and Reused","infrastructure","Resilience",209875,0.0075,["post_disaster_damage_survey", "seasonal_wall_replastering"],["construction", "materials"],"After a collapse, sound bricks are knocked clean of old mortar and stacked for rebuilding, saving the work of moulding new ones.",{"construction_rate": 0.003, "disaster_resilience": 0.002}),
