		_e("feud_ending_marriage","Feuds Ended by a Marriage Between the Two Sides","security","Public safety",100375,0.0154,["blood_price", "lineage_exogamy"],["defense", "warfare"],"When two lineages have long been feuding, the elders end it by marrying a daughter of one into the other, and the new kin may no longer fight.",{"security_efficiency": 0.002, "cohesion": 0.001}),
		_e("herds_restocked_after_murrain","Herds Restocked from the Temple Flock After a Murrain","security","Crisis resilience",122275,0.0106,["temple_flock_herders", "mutual_aid_customs"],["defense", "warfare"],"When a cattle plague or a hard winter kills a household's animals, the temple lends breeding stock to be repaid from their young.",{"disaster_resilience": 0.003, "food_output": 0.001}),
		_e("ward_wall_stretches","Each Ward Holds Its Own Stretch of the Town Wall","security","Organized defense",136875,0.0097,["town_enclosure_walls", "blank_outer_walls"],["defense", "warfare"],"Every ward is given a stretch of the town wall to man and keep in repair, and its men know their posts when the alarm sounds.",{"security_efficiency": 0.003, "task_coordination": 0.001}),
