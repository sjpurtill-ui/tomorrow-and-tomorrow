		_e("vacant_lot_allotment","Vacant Town Lots Allotted for New Houses","demography","Shelter capacity",178120,0.0078,["shared_party_walls", "public_space_allocation"],["population", "society"],"Empty plots inside the walls are recorded and granted to households that need to build, so the town fills its gaps before spreading outside.",{"housing_output": 0.003, "state_capacity": 0.001}),
