		_e("armed_herd_guards","Flocks Grazed Under Armed Guard Near Hostile Land","security","Public safety",87600,0.0210,["herding_rotas", "rotating_watch_captaincy"],["defense", "warfare"],"Near a hostile border the flocks go out with armed men as well as herd boys, and graze only where the watchers can see them.",{"security_efficiency": 0.002, "food_output": 0.001}),
