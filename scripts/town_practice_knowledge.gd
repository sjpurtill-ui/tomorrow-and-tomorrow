		_e("blank_outer_walls","Outer Houses Built Wall to Wall with No Doors Outward","security","Organized defense",79935,0.0244,["barred_palisade_gates", "defensive_ditch_siting"],["defense", "warfare"],"The outermost houses are built touching one another with no doors or windows facing out, so the village shows raiders a single blank wall.",{"security_efficiency": 0.003, "housing_output": 0.001}),
