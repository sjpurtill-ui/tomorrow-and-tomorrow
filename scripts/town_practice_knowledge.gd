		_e("named_four_winds","The Four Winds Named by Their Quarters","knowledge","Observers",87600,0.0210,["seasonal_patterns", "star_rise_markers"],["information", "research"],"The winds from each quarter of the sky have names, and people know which brings rain, which brings dust and which will fill a sail.",{"route_speed": 0.002, "disaster_resilience": 0.001}),
		_e("flock_evening_count","Flock Counted Each Evening by the Herd Boy","knowledge","Directed attention",95265,0.0176,["tallies", "grazing_rotation_customs"],["information", "research"],"Herd boys count the animals through the fold gate every evening, cutting a notch for each, and report any missing at once.",{"task_coordination": 0.002, "food_output": 0.001}),
		_e("clay_goods_labels","Small Labels Tied to Goods Naming Their Source","knowledge","Preserved knowledge",98915,0.0161,["stamp_seals", "marked_storage_registers"],["information", "research"],"Bone or clay tags tied to bundles and jars name the place and owner they came from, so a storeroom can sort deliveries without opening them.",{"storage_loss": -0.001, "knowledge_preservation": 0.001}),
		_e("thirty_day_account_months","Thirty-Day Months for Accounts and Rations","knowledge","Observers",102200,0.0146,["solar_year_reckoning", "impressed_number_tablets"],["information", "research"],"Account keepers count every month as thirty days and the year as twelve such months, so rations and labour can be reckoned without waiting on the moon.",{"state_capacity": 0.002, "task_coordination": 0.001}),
		_e("totals_checked_before_sealing","Totals Checked Against Their Parts Before Sealing","knowledge","Directed attention",113150,0.0112,["impressed_number_tablets", "thirty_day_account_months"],["information", "research"],"Before an account is sealed, the keeper adds up each entry again and checks the total on the back against the parts on the front.",{"state_capacity": 0.002, "knowledge_preservation": 0.001}),
		_e("verbatim_messages","Messengers Learn Their Message Word for Word","knowledge","Communication",114975,0.0111,["runner_relays_between_work_sites", "mnemonic_verse_encoding"],["information", "research"],"A messenger repeats his message back until it is word perfect and recites it the same way to the receiver, adding nothing of his own.",{"knowledge_preservation": 0.001, "state_capacity": 0.001}),
		_e("foreman_daily_logs","Foremen Keep a Daily Log of the Work","knowledge","Directed attention",142715,0.0062,["crew_count_scribes", "flock_evening_count"],["information", "research"],"A scribe with each crew writes what was done each day, where the crew slept and what was carried, so overseers see how the work goes.",{"task_coordination": 0.002, "knowledge_preservation": 0.001}),
		_e("duplicate_contract_copies","Each Party Keeps a Copy of the Contract","knowledge","Preserved knowledge",169725,0.0079,["clay_goods_labels", "sealed_tablet_contracts"],["information", "research"],"A sale or loan is written twice and each side takes one sealed copy home, so neither can later change the terms.",{"knowledge_preservation": 0.002, "legitimacy": 0.001}),
		_e("staged_pupil_lessons","Pupils Taught in Fixed Stages from Signs to Texts","knowledge","Directed attention",173375,0.0053,["scribal_apprenticeship", "public_schools"],["information", "research"],"Pupils first copy single signs, then lists of words, then model letters and contracts, moving up only when the master is satisfied.",{"knowledge_preservation": 0.002, "labor_efficiency": 0.001}),
		_e("letter_greeting_formula","Letters Open with a Set Greeting Naming Sender and Receiver","knowledge","Communication",175200,0.0079,["sealed_tablet_letters", "verbatim_messages"],["information", "research"],"Every letter begins by naming the one it is to be read to and the one who speaks, so the reader knows at once who writes and to whom.",{"state_capacity": 0.002, "knowledge_preservation": 0.001}),
		_e("outgoing_letter_copies","Copies Kept of Every Letter Sent","knowledge","Communication",177025,0.0079,["sealed_tablet_letters", "formal_archives"],["information", "research"],"Before a letter leaves the palace, a scribe copies it for the archive, so the court can later show what it promised and to whom.",{"knowledge_preservation": 0.002, "state_capacity": 0.001}),
		_e("model_contract_lessons","Model Contracts Copied as Lessons","knowledge","Directed attention",184325,0.0052,["staged_pupil_lessons", "sealed_tablet_contracts"],["information", "research"],"Pupils copy sample sales, loans and adoptions with made-up names, learning the exact wording a valid contract needs.",{"knowledge_preservation": 0.002, "state_capacity": 0.001}),
		_e("river_boat_letters","Letters Sent by Fast Boat Along the River","knowledge","Communication",184325,0.0078,["letter_greeting_formula", "hide_covered_boats"],["information", "research"],"Urgent letters go by light, fast boat along the river, reaching the next town far sooner than a runner on foot.",{"travel_speed": 0.002, "state_capacity": 0.001}),
