		_e("children_taught_swimming","Children of River Towns Taught to Swim","demography","Child survival",184325,0.0078,["children_kept_from_water", "navigation_canals"],["population", "society"],"Children in river towns are taught to swim in the canals while still small, and fewer drown when the flood comes or a boat overturns.",{"injury_risk": -0.0015, "neonatal_survival": 0.001}),
