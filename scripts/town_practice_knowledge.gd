		_e("dig_carry_turns","Diggers and Carriers Change Places at Midday","labor","Workload balance",97455,0.0167,["batch_sizing_by_fatigue", "cross_party_scheduling"],["administration", "training"],"On a large dig, the men with hoes and the basket carriers change places at midday, so no one wears out at the heaviest task.",{"fatigue": -0.0015, "labor_efficiency": 0.001}),
		_e("raised_grinding_querns","Querns Set on Raised Benches for Grinding","labor","Work efficiency",106945,0.0125,["flour_sifting"],["administration", "training"],"Grinding stones are set into a waist-high bench of clay, so women grind kneeling or standing instead of bent over a stone on the floor.",{"labor_efficiency": 0.0015, "fatigue": -0.001}),
		_e("fieldworker_water_carriers","Water Carried to Workers in the Fields","labor","Workload balance",108405,0.0119,["seasonal_labor_pooling"],["administration", "training"],"Boys and old men carry water skins along the rows at harvest, so reapers need not walk back to the well.",{"fatigue": -0.001, "labor_efficiency": 0.001}),
		_e("hand_to_hand_lines","Baskets Passed Hand to Hand Along a Line","labor","Work efficiency",129575,0.0102,["dig_carry_turns", "load_bundling_by_weight"],["administration", "training"],"Earth and bricks are passed along a line of workers from hand to hand, instead of each worker walking the whole way with his own load.",{"labor_efficiency": 0.001, "fatigue": -0.001}),
		_e("captive_field_labour","War Captives Set to Grinding and Weaving","labor","Able workforce",133225,0.0099,["captive_adoption"],["administration", "training"],"Men and women taken in raids are put to work at the querns, looms and fields of the temple or chief, adding hands without new births.",{"labor_efficiency": 0.001, "cohesion": -0.002}),
		_e("levy_service_turns","Levy Duty Taken in Turns So No Household Serves Twice","labor","Workload balance",136875,0.0097,["census_rolls", "grain_levy_accounting"],["administration", "training"],"The register shows who served last, and the levy is called from households that have not yet served, so the burden is spread.",{"fatigue": -0.001, "cohesion": 0.001, "legitimacy": 0.001}),
		_e("year_round_skilled_core","A Core of Year-Round Skilled Workers at the Great Works","labor","Able workforce",142715,0.0062,["great_work_parties", "full_time_specialists"],["administration", "training"],"Masons, surveyors and toolmakers stay at a great work all year, while farmers come only for their season of levy duty.",{"labor_efficiency": 0.0015, "construction_rate": 0.001}),
		_e("gang_marks_on_blocks","Each Gang's Mark Painted on Its Blocks","labor","Coordination",149650,0.0089,["gangs_of_ten", "crew_count_scribes"],["administration", "training"],"Every gang paints its name on the stones it quarries and sets, so the overseer can count each gang's work and find who set a bad block.",{"task_coordination": 0.002, "construction_rate": 0.002}),
		_e("work_site_supply_rounds","Supplies Brought to the Great Work on a Fixed Round","labor","Coordination",162425,0.0081,["rotating_named_gangs", "fixed_worker_rations"],["administration", "training"],"Boats and donkey trains bring grain, beer and tools to the great work on fixed days, so crews never stand idle waiting for their rations.",{"task_coordination": 0.002, "labor_efficiency": 0.001}),
		_e("extra_day_rations","Extra Rations for Extra Days Worked","labor","Workload balance",169725,0.0079,["levy_service_turns", "worker_ration_lists"],["administration", "training"],"A worker who serves beyond his owed days is given extra bread and beer for each extra day, written on the ration list.",{"labor_efficiency": 0.001, "fatigue": -0.001, "food_storage": -0.001}),
		_e("trodden_brick_clay","Brick Clay Trodden by Teams Before Moulding","labor","Work efficiency",175565,0.0079,["brick_quotas", "hand_to_hand_lines"],["administration", "training"],"Teams tread the wet clay and straw together in pits until it is even, so the moulders can keep up their daily count.",{"labor_efficiency": 0.001, "construction_rate": 0.002}),
		_e("two_spindle_spinning","Spinners Working Two Spindles at Once","labor","Work efficiency",195275,0.0077,["drop_spindles", "temple_workshops"],["administration", "training"],"Skilled spinners keep two spindles turning at once, one from each hand, and draw far more yarn from a day's work.",{"labor_efficiency": 0.001, "craft_output": 0.001}),
		_e("measured_canal_stretches","Canal Clearing Shared by Measured Stretches","labor","Coordination",200750,0.0076,["canal_wardens", "daily_task_norms"],["administration", "training"],"Each village is given a measured length of the canal to clear, so the work is fair and a skipped stretch is easy to find.",{"task_coordination": 0.003, "cultivation_yield": 0.001}),
		_e("mill_house_grinding","Grain Ground in Mill-Houses by Many Hands","labor","Work efficiency",201115,0.0076,["raised_grinding_querns", "captive_field_labour"],["administration", "training"],"The great households grind grain for their workers in mill-houses where rows of women work querns side by side under one overseer.",{"labor_efficiency": 0.0015, "food_output": 0.001}),
		_e("ore_hand_sorting","Ore Broken and Hand-Sorted Before Smelting","production","Material supply",90885,0.0196,["fire_setting_mining", "arsenical_copper"],["crafting", "materials"],"Miners break the ore with stone hammers and pick out the rich green and blue pieces by hand, so less barren rock goes into the furnace.",{"metal_yield": 0.003, "fuel_efficiency": 0.001}),
		_e("pulled_flax","Flax Pulled by the Root for Long Fibre","production","Material supply",100375,0.0154,["fiber_retting", "plain_weaving"],["crafting", "materials"],"Flax is pulled up by hand instead of cut, keeping the full length of the stem, so it spins into longer and stronger linen thread.",{"fiber_yield": 0.003, "craft_output": 0.001}),
		_e("reed_mat_weaving","Reed Mats Woven in Bulk for Roofs and Floors","production","Craft capacity",102565,0.0145,["reed_bundle_houses", "basketry"],["crafting", "materials"],"Split reeds are plaited into large mats by the hundred, to be laid over roof beams under the mud and spread on floors.",{"craft_output": 0.002, "construction_rate": 0.002}),
		_e("river_sand_gold","Gold Washed from River Sand","production","Material supply",104025,0.0138,["native_copper_working", "ore_assaying"],["crafting", "materials"],"Gold seekers wash river sand in wooden trays or over fleeces, and the heavy grains of gold settle out of the lighter sand.",{"metal_yield": 0.002, "trade_capacity": 0.001}),
		_e("graded_grinding_sand","Grinding Sand Graded from Coarse to Fine","production","Tool quality",114975,0.0111,["tube_drilled_stone_vessels", "ground_stone_axes"],["crafting", "materials"],"Stoneworkers sort their grinding sand from coarse to fine, roughing out a bowl or bead with the coarse and finishing it with the finest.",{"tool_quality": 0.002, "craft_output": 0.002}),
		_e("graded_wool_weighing","Wool Weighed Out by Grade for Spinning","production","Standardization",114975,0.0111,["wool_spinning", "balance_beam_weights"],["crafting", "materials"],"Fleece is sorted into fine, middling and coarse and weighed out to the spinners, who must return the same weight as yarn.",{"standardization": 0.003, "craft_output": 0.001}),
		_e("winter_felled_timber","Timber Felled in Winter When the Sap Is Low","production","Material supply",114975,0.0111,["timber_seasoning", "timber_stand_reserves"],["crafting", "materials"],"Trees for beams are cut in the cold months when the sap is low, and the timber dries with fewer cracks and less rot.",{"timber_yield": 0.003, "repair_capacity": 0.001}),
		_e("standard_reed_bundles","Reeds Sold in Bundles of One Girth","production","Standardization",129575,0.0102,["reed_mat_weaving", "standard_unit_naming"],["crafting", "materials"],"Reeds are cut and tied in bundles of a set girth, so builders, boatmen and mat-makers buy and count them by the bundle.",{"standardization": 0.003, "construction_rate": 0.001}),
		_e("mortise_joined_furniture","Beds and Stools Joined with Mortise and Tenon","production","Craft capacity",135415,0.0098,["timber_post_beam_connections", "copper_carpentry_tools"],["crafting", "materials"],"Carpenters fit legs and rails into cut sockets and peg them, making beds and stools that stand firm for years.",{"craft_output": 0.003, "housing_output": 0.001}),
		_e("level_struck_measures","Grain Measures Struck Level with a Rod","production","Standardization",155125,0.0086,["standard_unit_naming", "public_grain_weighing"],["crafting", "materials"],"Grain in a measure is struck level with a straight rod, so a measure filled by a generous hand or a greedy one counts the same.",{"standardization": 0.003, "trade_capacity": 0.001}),
		_e("hard_stone_bead_batches","Hard Stone Beads Bored in Workshop Batches","production","Craft capacity",158775,0.0056,["graded_grinding_sand", "relay_trade_gemstones", "visiting_master_craftsmen"],["crafting", "materials"],"Bead makers saw, grind and bore hard red stone in batches, passing each bead through the same steps, for trade far beyond the town.",{"craft_output": 0.003, "trade_capacity": 0.001}),
		_e("hide_bone_glue","Glue Boiled from Hide and Bone","production","Material supply",166075,0.0080,["hide_tanning", "mortise_joined_furniture"],["crafting", "materials"],"Scraps of hide and bone are boiled down to a glue that holds joints, inlays and thin wooden facings in place as it sets.",{"craft_output": 0.002, "repair_capacity": 0.001}),
		_e("stamped_bricks","Bricks Stamped with the Ruler's Name","production","Standardization",177025,0.0079,["standard_brick_proportions", "first_basket_founding"],["crafting", "materials"],"Moulders stamp the bricks for a ruler's buildings with his name, so they are counted and cannot be carried off to private houses.",{"standardization": 0.002, "legitimacy": 0.001}),
		_e("pleated_linen","Linen Pleated on Grooved Boards","production","Craft capacity",182865,0.0078,["temple_workshops", "pulled_flax"],["crafting", "materials"],"Fine linen is pressed damp into grooved boards so it dries in narrow pleats, a mark of good cloth worn by people of rank.",{"craft_output": 0.002, "trade_capacity": 0.001}),
		_e("scented_oils","Scented Oils Made by Steeping Plants in Oil","production","Craft capacity",184325,0.0052,["seed_oil_pressing", "skin_oiling"],["crafting", "materials"],"Flowers, resins and herbs are steeped in warm oil for days and strained, giving scented oils for anointing and trade.",{"craft_output": 0.002, "trade_capacity": 0.002}),
		_e("standard_cloth_lengths","Cloth Woven to Standard Lengths for Trade","production","Standardization",184325,0.0078,["graded_wool_weighing", "temple_workshops"],["crafting", "materials"],"Weavers make lengths of cloth of one size and weight, so traders can buy and sell them by the piece.",{"standardization": 0.003, "trade_capacity": 0.002}),
		_e("fine_wood_facings","Thin Sheets of Fine Wood Laid over Plain Timber","production","Craft capacity",195275,0.0077,["hide_bone_glue", "copper_carpentry_tools"],["crafting", "materials"],"Joiners glue thin sheets of ebony and other rare woods over plain timber, so a chest or chair looks costly while using little of the precious wood.",{"craft_output": 0.003, "trade_capacity": 0.001}),
		_e("cast_on_tool_repair","Broken Bronze Tools Mended by Casting On","production","Tool quality",202575,0.0076,["closed_moulds", "cored_socket_casting"],["crafting", "materials"],"A broken axe or socket is set back into a mould and fresh bronze is poured onto it, mending the tool instead of melting it all down.",{"tool_quality": 0.002, "repair_capacity": 0.002}),
		_e("raised_sleeping_benches","Sleeping Benches Raised Off the Damp Floor","health","General health",85775,0.0218,["household_space_planning", "adobe_wall_construction"],["health", "illness"],"Families sleep on benches of packed earth or brick built along the walls, up off the damp floor and away from crawling vermin.",{"health_protection": 0.001, "disease_exposure": -0.001}),
		_e("door_smoke_fires","Smoky Fires at the Door Against Biting Flies","health","Disease control",90155,0.0199,["cookfire_smoke_venting_habit", "drainage"],["health", "illness"],"In the fly season, smoky fires of dung and green leaves burn at the doorways at dusk, keeping gnats and biting flies off the sleepers.",{"disease_exposure": -0.0015, "fatigue": -0.001}),
		_e("roped_well_diggers","Well Diggers Work on a Rope Held from Above","health","Injury safety",96725,0.0170,["lined_well_shafts", "workplace_hazard_awareness"],["health", "illness"],"A man digging or cleaning a deep well works tied to a rope held by a partner above, who hauls him out if the sides slip or the air turns foul.",{"injury_risk": -0.0015}),
		_e("chewed_twig_toothcare","Chewed Twigs and Ash Powder for Cleaning Teeth","health","General health",104025,0.0138,["herbal_classification"],["health", "illness"],"People clean their teeth with the frayed end of a chewed twig and rub them with ash or powdered stone.",{"health_protection": 0.001}),
		_e("boiled_herb_decoctions","Remedies Boiled into Decoctions","health","Disease control",114975,0.0111,["herbal_classification", "clay_dome_ovens"],["health", "illness"],"Roots and leaves are boiled down in water or beer to a strong brew that the sick drink in set amounts.",{"health_protection": 0.001, "disease_exposure": -0.001}),
		_e("roof_edge_walls","Low Walls Around Roofs Where People Sleep","health","Injury safety",122275,0.0106,["flat_clay_roofs", "workplace_hazard_awareness"],["health", "illness"],"Flat roofs where families sleep and work in summer are given a low wall around the edge, so children and sleepers do not fall to the lane below.",{"injury_risk": -0.0015}),
		_e("hand_washing_ewer","Hands Washed from Ewer and Basin Before Meals","health","Water & sanitation",133225,0.0099,["water_container_cleaning_customs", "sheet_copper_riveting"],["health", "illness"],"Before eating, water is poured over the hands from a spouted ewer into a basin, and the dirty water is carried away.",{"disease_exposure": -0.0015, "sanitation": 0.001}),
		_e("sick_animal_separation","Diseased Animals Separated from the Flock","health","Disease control",133225,0.0099,["sickbed_distance_norms", "scrap_fed_pigs"],["health", "illness"],"A sheep, pig or ox with scab or a wasting sickness is penned apart and watched, so the rest of the herd does not catch it.",{"disease_exposure": -0.001, "food_output": 0.001}),
		_e("embedded_point_removal","Embedded Points and Splinters Cut Out of Wounds","health","Injury safety",140525,0.0095,["wound_cleaning", "wound_packing"],["health", "illness"],"A healer opens the flesh with a fine blade to draw out a broken arrow point or splinter, then washes and packs the wound.",{"injury_risk": -0.0015, "health_protection": 0.001}),
		_e("house_bathing_floors","House Bathing Floors Drained to the Street","health","Water & sanitation",151475,0.0088,["hand_washing_ewer", "stone_lined_drains"],["health", "illness"],"Houses set aside a small room with a sloping brick floor for washing, which drains through the wall into the lane drain.",{"sanitation": 0.002, "disease_exposure": -0.001}),
		_e("scaffold_lashing","Scaffolds Lashed for Work on High Walls","health","Injury safety",164615,0.0080,["rope_laying", "course_leveling_practice"],["health", "illness"],"Builders lash poles into scaffolds and ramps along a rising wall, so no one has to work from a ladder or the top of the wall.",{"injury_risk": -0.0015, "construction_rate": 0.001}),
		_e("purification_washing","The Sick Washed with Water and Herbs in Purification Rites","health","Disease control",169725,0.0079,["sickroom_fumigation", "boiled_herb_decoctions"],["health", "illness"],"The healer-priest washes the sick person with water steeped in tamarisk and other plants, and the water is poured out far from the house.",{"disease_exposure": -0.001, "cohesion": 0.0005}),
		_e("latrine_seats_over_drains","Brick Latrine Seats over Drains","health","Water & sanitation",173375,0.0079,["house_bathing_floors", "latrine_siting"],["health", "illness"],"Houses with a drain build a brick seat over it in a small room, so waste goes into the drain instead of the yard.",{"sanitation": 0.002, "disease_exposure": -0.001}),
		_e("work_crew_healer","A Healer Posted with the Work Crews","health","Injury safety",173375,0.0079,["healer_titles", "year_round_skilled_core"],["health", "illness"],"A healer stays with the crews of a great work, setting broken bones and dressing crushed hands on the spot instead of sending the injured home.",{"injury_risk": -0.0015, "labor_efficiency": 0.001}),
		_e("strained_drinking_water","Drinking Water Strained Through Cloth","health","Water & sanitation",184325,0.0078,["water_settling_basins", "water_container_cleaning_customs"],["health", "illness"],"Water from the river or canal is poured through a cloth into the drinking jar, leaving mud, worms and small creatures behind.",{"water_safety": 0.0015, "disease_exposure": -0.001}),
		_e("sickbed_linen_cleansing","Clothes and Bedding of the Sick Scrubbed or Burned","health","Disease control",187975,0.0077,["isolation_practice", "sickroom_fumigation"],["health", "illness"],"When a sickness has passed, the clothes and bedding of the sick are scrubbed with ash and water or burned, and the room is swept and freshly whitewashed.",{"disease_exposure": -0.0015}),
		_e("shrine_entry_washing","Hands and Feet Washed Before Entering the Shrine","health","Water & sanitation",211700,0.0075,["hand_washing_ewer", "first_shrine_house"],["health", "illness"],"Basins of water stand at the shrine gate, and no one enters the god's court without washing hands and feet, priests most of all.",{"sanitation": 0.0015, "disease_exposure": -0.001}),
		_e("seasonal_wall_replastering","Mud Plaster Renewed on Walls After the Rains","infrastructure","Construction",79205,0.0247,["adobe_wall_construction"],["construction", "materials"],"Each year after the rains, households smear fresh mud plaster over their walls and roofs, closing cracks before they let in water.",{"repair_capacity": 0.003, "disaster_resilience": 0.002}),
		_e("raised_wet_causeways","Raised Earth Causeways Across Wet Ground","infrastructure","Public works",82855,0.0231,["flood_levees", "plank_trackways"],["construction", "materials"],"Villages build up banks of earth across marsh and flood land, so people and herds can cross dry-shod in the wet season.",{"route_speed": 0.003, "disaster_resilience": 0.002}),
		_e("stone_pivot_doors","Doors Hung on Stone Pivot Sockets","infrastructure","Housing",104025,0.0138,["timber_post_beam_connections"],["construction", "materials"],"A door's post turns in a hollow cut into a stone set in the floor, so heavy wooden doors swing easily and shut tight.",{"housing_output": 0.002, "security_efficiency": 0.001}),
		_e("gravelled_main_streets","Main Streets Surfaced with Gravel and Broken Pottery","infrastructure","Public works",122275,0.0106,["public_space_allocation", "stone_lined_drains"],["construction", "materials"],"The main streets are spread with gravel and potsherds that drain quickly, so carts and porters are not stopped by mud after rain.",{"route_speed": 0.002, "sanitation": 0.001}),
		_e("street_corner_wells","Public Wells at Street Crossings","infrastructure","Public works",140525,0.0095,["protected_wellheads", "roped_well_diggers"],["construction", "materials"],"Wells lined with brick are dug where streets meet, so every household has water within a short walk.",{"water_access": 0.002, "water_safety": 0.001}),
		_e("bank_breach_closing","Breaks in the River Bank Closed with Reed Bundles","infrastructure","Resilience",158775,0.0083,["flood_levees", "storm_response_drill"],["construction", "materials"],"When a bank gives way, crews drive stakes across the gap, pile in bundles of reeds and pack earth behind them before the whole field floods.",{"disaster_resilience": 0.003, "labor_demand": 0.0005}),
		_e("spare_rebuilding_timber","Spare Timber Stored for Rebuilding After Fire","infrastructure","Resilience",173375,0.0079,["distant_timber_reserves", "winter_felled_timber"],["construction", "materials"],"The stores keep seasoned beams and reed bundles in reserve, so roofs lost to fire or storm can be replaced at once.",{"disaster_resilience": 0.003, "construction_rate": 0.001}),
		_e("building_plan_tablets","Builders Work from a Plan Drawn on a Tablet","infrastructure","Construction",175200,0.0079,["geometric_survey", "corner_squaring_method"],["construction", "materials"],"The plan of a building is drawn to scale on a tablet with its walls and doors, and the builders lay out their cords from it.",{"construction_rate": 0.002, "task_coordination": 0.001}),
		_e("sand_bed_foundations","Foundation Trenches Filled with Clean Sand","infrastructure","Construction",184325,0.0078,["ground_bearing_assessment", "course_leveling_practice"],["construction", "materials"],"Before a great wall goes up, its trench is filled with clean sand and levelled, so the weight spreads and the wall settles evenly.",{"construction_rate": 0.002, "disaster_resilience": 0.001}),
		_e("dyke_high_water_watch","Dyke Watch Kept Day and Night at High Water","infrastructure","Resilience",190895,0.0077,["bank_breach_closing", "flood_levees"],["construction", "materials"],"When the river nears the top of its banks, men watch the dykes in shifts through the night and sound the alarm at the first seep.",{"disaster_resilience": 0.004, "labor_demand": 0.001}),
		_e("dyke_stretch_duty","Field Owners Keep Their Stretch of the Dyke","infrastructure","Public works",195275,0.0077,["raised_wet_causeways", "village_track_upkeep"],["construction", "materials"],"Each landholder must keep the dyke along his field sound, and one whose neglect lets the water through repays his neighbours' lost crops.",{"disaster_resilience": 0.003, "legitimacy": 0.0005, "labor_demand": 0.0005}),
		_e("brick_count_reckoning","Bricks for a Wall Reckoned in Advance","infrastructure","Construction",202575,0.0076,["building_plan_tablets", "trodden_brick_clay"],["construction", "materials"],"Scribes work out from a wall's length, height and thickness how many bricks it needs, so moulders and carriers are set to work in the right numbers.",{"construction_rate": 0.003, "task_coordination": 0.001}),
		_e("fallen_brick_reuse","Bricks from Fallen Walls Cleaned and Reused","infrastructure","Resilience",209875,0.0075,["spare_rebuilding_timber", "seasonal_wall_replastering"],["construction", "materials"],"After a collapse, sound bricks are knocked clean of old mortar and stacked for rebuilding, saving the work of moulding new ones.",{"construction_rate": 0.003, "disaster_resilience": 0.002}),
		_e("window_grilles","High Windows Closed with Grilles","infrastructure","Housing",211700,0.0075,["stone_pivot_doors", "upper_storeys"],["construction", "materials"],"High windows are fitted with grilles of wood or pierced stone, letting in light and air while keeping out thieves and birds.",{"housing_output": 0.001, "security_efficiency": 0.001}),
		_e("fruit_trees_left_standing","Fruit and Shade Trees Left Standing When Land Is Cleared","ecology","Natural recovery",87600,0.0210,["windbreak_hedgerow_siting", "selective_deadwood_gathering"],["nature", "survey"],"When a new field is cleared, wild fig, almond and nut trees are left standing, so the land keeps some cover and the household some fruit.",{"ecology_recovery": 0.002, "food_output": 0.001}),
		_e("brush_fired_kilns","Kilns Fired with Brush and Reeds to Spare the Woods","ecology","Resource sustainability",89425,0.0202,["selective_deadwood_gathering", "pit_firing"],["nature", "survey"],"Potters and lime burners feed their kilns with brushwood, reeds and chaff wherever they can, keeping the scarce timber for beams.",{"fuel_demand": -0.002, "ecological_pressure": -0.001}),
		_e("retting_pools_apart","Flax Retting Pools Kept Apart from Drinking Water","ecology","Pollution control",100375,0.0154,["fiber_retting", "water_container_cleaning_customs"],["nature", "survey"],"Flax is left to rot loose in pools dug away from the wells and the drinking channel, since its foul water sickens anyone who drinks it.",{"water_pollution": -0.002, "disease_exposure": -0.001}),
		_e("town_refuse_to_fields","Town Refuse Carted Out to the Fields","ecology","Pollution control",114975,0.0111,["refuse_pit_rotation", "manure_field_spreading"],["nature", "survey"],"Ash, sweepings and dung from the town are carried out to the fields each season instead of piling up in the lanes.",{"pollution": -0.002, "soil_productivity": 0.001, "disease_exposure": -0.001}),
		_e("carcass_burial_away","Carcasses Buried Away from Water and Houses","ecology","Pollution control",125925,0.0104,["refuse_removal", "midden_siting_away_from_water"],["nature", "survey"],"Dead animals are dragged well away from houses and wells and buried or burned instead of being left to rot.",{"disease_exposure": -0.001, "water_pollution": -0.001}),
		_e("topsoil_saved_on_terraces","Topsoil Set Aside and Spread Back on New Terraces","ecology","Natural recovery",136875,0.0097,["topsoil_depth_reading", "dry_stone_walls"],["nature", "survey"],"When a terrace is built, the dark topsoil is scraped off first and spread back over the new step, so the field bears from its first year.",{"soil_productivity": 0.0015, "ecology_recovery": 0.001}),
		_e("leveled_basin_fields","Fields Levelled So Water Spreads Evenly","ecology","Land health",158775,0.0083,["rod_and_cord_leveling", "canal_strip_fields"],["nature", "survey"],"Before watering, fields are levelled with boards dragged by oxen, so water spreads evenly instead of pooling and leaving salt behind.",{"soil_productivity": 0.0015, "water_access": 0.001}),
		_e("slaughter_waste_removal","Slaughter Waste Carried Out Past the Houses","ecology","Pollution control",158775,0.0083,["refuse_pit_rotation", "carcass_burial_away"],["nature", "survey"],"Butchers kill outside the gate or carry the blood and offal out to a pit beyond the houses, so the lanes do not stink or draw flies.",{"pollution": -0.002, "disease_exposure": -0.001}),
		_e("drain_settling_sumps","Sump Pits Settle Drain Water Before It Flows Away","ecology","Pollution control",182500,0.0078,["covered_sewers", "latrine_seats_over_drains"],["nature", "survey"],"Drains pass through brick-lined pits where solid waste settles and is dug out, so the outflow runs cleaner.",{"water_pollution": -0.003, "sanitation": 0.001}),
