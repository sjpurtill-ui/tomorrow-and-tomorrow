		_e("old_inscription_copies","Old Inscriptions Copied for the Archive","culture","Collective memory",215715,0.0050,["foundation_deposits", "ruler_year_lists", "broken_source_marking"],["society", "information"],"Scribes copy the writing on old foundation tablets and monuments into the archive, keeping the deeds of rulers long dead.",{"knowledge_preservation": 0.003}),
		_e("bride_service","A Groom Works for His Bride's Father","demography","Fertility conditions",85045,0.0221,["lineage_exogamy", "patrilocal_residence"],["population", "society"],"A young man too poor to pay for a bride works some years in the house of her father, so the couple can marry without waiting for wealth.",{"conception_support": 0.0015, "cohesion": 0.001}),
